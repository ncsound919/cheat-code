<?xml version="1.0" encoding="utf-8"?>
<!--
  Three narrow shares: the flyer and bet-slip PNGs drawn for the share sheet, and the APK
  the in-app updater downloaded. Nothing else in the app's storage is reachable through
  this provider.
-->
<paths>
    <cache-path name="flyers" path="flyers/" />
    <cache-path name="slips" path="slips/" />
    <cache-path name="updates" path="updates/" />
    <cache-path name="captures" path="captures/" />
</paths>
