<?xml version="1.0" encoding="utf-8"?>
<!--
  Backups are already off. This file makes that explicit on Android 12+, where the
  platform consults extraction rules before either cloud backup or device transfer.
  Keys, the paper ledger and the signed-in address are all app-private data.
-->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="root" path="." />
        <exclude domain="file" path="." />
        <exclude domain="database" path="." />
        <exclude domain="sharedpref" path="." />
        <exclude domain="external" path="." />
    </cloud-backup>
    <device-transfer>
        <exclude domain="root" path="." />
        <exclude domain="file" path="." />
        <exclude domain="database" path="." />
        <exclude domain="sharedpref" path="." />
        <exclude domain="external" path="." />
    </device-transfer>
</data-extraction-rules>
